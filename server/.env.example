# Diwakar Ji Laundry Server Environment Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Option A: Supabase PostgreSQL Database (Production Cloud)
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret

# Option B: MySQL Database (Local Dev)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=diwakar_laundry

# Option C: File Store (Dual-Mode Resilient Fallback)
# When neither MySQL nor Postgres is connected, automatically persists to server/data/diwakar_store.json

